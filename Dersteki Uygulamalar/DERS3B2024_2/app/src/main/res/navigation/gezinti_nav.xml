<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gezinti_nav"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.ders3b2024_2.FirstFragment"
        android:label="fragment_first"
        tools:layout="@layout/fragment_first" >
        <action
            android:id="@+id/ilk"
            app:destination="@id/baskaFragment"
            app:exitAnim="@android:anim/slide_in_left" />
    </fragment>
    <fragment
        android:id="@+id/baskaFragment"
        android:name="com.example.ders3b2024_2.SecondFragment"
        android:label="fragment_second"
        tools:layout="@layout/fragment_second" >
        <action
            android:id="@+id/iki"
            app:destination="@id/sonFragment"
            app:popUpTo="@id/baskaFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="Ad"
            app:argType="string"
            android:defaultValue="isim" />
        <argument
            android:name="yas"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="mstr"
            app:argType="com.example.ders3b2024_2.Musteriler" />
    </fragment>
    <fragment
        android:id="@+id/sonFragment"
        android:name="com.example.ders3b2024_2.SonFragment"
        android:label="fragment_son"
        tools:layout="@layout/fragment_son" />
    <fragment
        android:id="@+id/baskaFragment"
        android:name="com.example.ders3b2024_2.BaskaFragment"
        android:label="fragment_baska"
        tools:layout="@layout/fragment_baska" />
</navigation>